# SocialReins settings. Self-host: `cp .env.example .env`, then `docker compose up -d`.
# Local web development: `cp .env.example .env.local`; web itself reads only BRAIN_URL.
# Every variable is optional unless marked REQUIRED.

# --- Public URLs (no trailing slash) ---
# brain's public URL: web calls it from the browser, emailed links and OAuth callbacks point here.
BRAIN_URL=http://localhost:8080
# web's public URL: sign-in lands here, and it is the passkey relying party and the CORS origin.
WEB_URL=http://localhost:3000
# web and brain must share a registrable domain (e.g. app.example.com and api.example.com) so
# the SameSite=Lax session cookie on brain's host is sent from web's pages.

# --- Images and ports (docker compose only) ---
# Image tag of ghcr.io/socialreins/brain and ghcr.io/socialreins/web: main, latest or vX.Y.Z.
SOCIALREINS_VERSION=main
# Host ports, published on 127.0.0.1 only: put a reverse proxy in front for a public install.
BRAIN_PORT=8080
WEB_PORT=3000

# --- Database (docker compose only) ---
# REQUIRED. Generate one: openssl rand -hex 24 (hex keeps it safe inside DATABASE_URL).
POSTGRES_PASSWORD=change-me

# --- Behind a reverse proxy ---
# true only when a proxy sets X-Forwarded-For and brain is not reachable around it, so the rate
# limit keys on the real client IP.
TRUST_PROXY=false

# --- Sign-up ---
# true: only the first account (yours) and invited emails can sign up. Existing users still sign in.
REGISTRATION_DISABLED=false

# --- Mail ---
# With neither Resend nor SMTP set, sign-in links are written to brain's log
# (`docker compose logs brain`); MAIL_LOG=true hides the warning about it.
# RESEND_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example.com
# Required with Resend or SMTP:
# MAIL_FROM=SocialReins <login@example.com>
# MAIL_LOG=false

# --- Passkeys (defaults come from WEB_URL) ---
# PASSKEY_RP_ID=example.com
# PASSKEY_RP_ORIGIN=https://app.example.com

# --- Logs ---
# RUST_LOG=info

# --- Platform apps, all optional ---
# A platform shows as "not configured" until its app is set. Connectors are being built:
# brain reads these once each one ships. Redirect URIs to register: see README "Platform apps".
# META_APP_ID=
# META_APP_SECRET=
# Generate one: openssl rand -hex 32
# META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_VERSION=v26.0
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
